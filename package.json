{
  "name": "webhook-shield",
  "version": "0.1.0",
  "description": "Secure, framework-agnostic webhook signature verification for TypeScript.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE", "SECURITY.md"],
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:acceptance": "npm run build && vitest run test/public-api.acceptance.test.ts",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0"
  }
}
